# Django
SECRET_KEY=django-insecure-replace-this-in-production-50chars-minimum
DEBUG=False
ALLOWED_HOSTS=109.196.103.11,localhost,yourdomain.com

# Database
POSTGRES_DB=teledent
POSTGRES_USER=teledent_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# CORS — список origins для XHR/fetch с фронта (с https://)
CORS_ALLOWED_ORIGINS=http://109.196.103.11,https://yourdomain.com

# CSRF — нужно для Django admin и любого POST с HTTPS-домена (scheme://host)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email (SMTP) — восстановление пароля. По умолчанию письма в консоль; на проде smtp.
# Пароль почтового ящика — только в .env на сервере, в репозиторий не коммитим.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=noreply@yourdomain.ru
EMAIL_HOST_PASSWORD=change_this_mailbox_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.ru
# Базовый URL фронта — из него строятся ссылки в письмах (сброс пароля)
FRONTEND_URL=https://yourdomain.ru

# Gemini API (Stage 2) — direct API mode (требует жилой IP в локациях где доступен)
GEMINI_API_KEY=your-gemini-api-key-here

# Vertex AI (Stage 2) — обход IP-блокировки бесплатного Gemini API через Google Cloud
# При USE_VERTEX_AI=true gemini.py создаёт клиент в режиме Vertex и игнорирует GEMINI_API_KEY.
# Service account JSON кладётся в ./secrets/vertex-key.json (volume в backend контейнере).
USE_VERTEX_AI=false
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/vertex-key.json

# OpenRouter — шлюз к Qwen3-VL (вторая нейросеть)
# Slug'и моделей: qwen/qwen3-vl-235b-a22b-instruct, qwen/qwen3-vl-30b-a3b-instruct, qwen/qwen2.5-vl-72b-instruct
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=https://radugaulybok-dent.ru
OPENROUTER_APP_TITLE=Raduga Ulybok

# GigaChat (Сбер) — третья нейросеть. Ключ авторизации и scope из личного кабинета GigaChat.
# Модели (vision): GigaChat-2-Max, GigaChat-2-Pro, GigaChat-2, GigaChat-Max, GigaChat-Pro
# GIGACHAT_VERIFY_SSL=false (дефолт) — без проверки TLS; или укажите GIGACHAT_CA_BUNDLE
# (путь к «Russian Trusted Root CA») и поставьте true. GIGACHAT_BASE_URL — опционально,
# переопределение эндпоинта (прокси на РФ если API недоступен с IP сервера).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false
GIGACHAT_CA_BUNDLE=
GIGACHAT_BASE_URL=

# Хранилище фото на РФ (152-ФЗ) — MinIO (S3) на 109.196.103.11.
# При USE_S3_PHOTOS=true фото анализов пишутся в MinIO, а не на локальный диск.
# PDF-документы (инструкция, юр-доки) этим НЕ затрагиваются — они не ПД.
USE_S3_PHOTOS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=teledent-photos
# Публичный HTTPS-эндпоинт MinIO (медиа-поддомен на РФ).
AWS_S3_ENDPOINT_URL=https://media.radugaulybok-dent.ru
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_EXPIRE=3600
